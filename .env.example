# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbancenter

# JSON Web Tokens (use the same value for both)
JWT_SECRET_KEY=change-me
JWT_SECRET=change-me

# AWS S3 for report images
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Server
PORT=8080
